{
  "name": "libretv-portable",
  "version": "2.19.2-desktop.8",
  "description": "静观 TV Windows portable desktop application",
  "author": "LibreTV contributors",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "node prepare.cjs",
    "start": "electron .",
    "pack": "electron-builder --win --x64 --dir",
    "package:release": "node package-release.cjs",
    "dist": "npm run prepare:web && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.librespark.libretv.portable",
    "productName": "静观 TV",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["main.cjs", "package.json", "LICENSE"],
    "extraResources": [{ "from": "resources", "to": "." }],
    "win": {
      "icon": "icon.ico",
      "target": [{ "target": "dir", "arch": ["x64"] }],
      "artifactName": "静观TV.exe",
      "signExecutable": false
    }
  }
}
